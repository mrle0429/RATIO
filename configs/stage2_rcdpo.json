{
  "entrypoint": "python -m ratio_rcdpo.train_stage2",
  "objective": "clean/rewrite supervised detection + RCDPO preference + pair consistency + reference KL",
  "data": {
    "source": "PACT/datasplit/rewrite_grouped",
    "train_data": "data/rewrite/train.jsonl",
    "val_data": "data/rewrite/val.jsonl",
    "test_data": "data/rewrite/test.jsonl",
    "stage1_checkpoint": "outputs/ratio_stage1/best_model.pt"
